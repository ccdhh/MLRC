<?xml version="1.0" encoding="UTF-8"?>
<Configuration>
    <AlignedSize>4096</AlignedSize>
    <UnitSize>8192</UnitSize>
    <BlockSize>16777216</BlockSize>
    <!--64MB=67108864; 1MB=1048576-->
    <!--8388608-->
    <!--67108864-->
    <DatanodeNumPerCluster>8</DatanodeNumPerCluster>
    <ClusterNum>16</ClusterNum>
    <!-- Multi-machine: set to coordinator host IP reachable from clients.
         You can also override without editing this file: ./main_client <ip:port> or COORDINATOR_ADDR=<ip:port> -->
    <CoordinatorIP>10.10.1.2</CoordinatorIP>
    <CoordinatorPort>55555</CoordinatorPort>
    <!-- Coordinator listens on 0.0.0.0:CoordinatorPort. Proxies use port from clusterInformation.xml; data port = proxy_port+1. Start proxy as: ./run_proxy <ip>:50405 -->
    <!-- AppendMode: REP_MODE; UNILRC_MODE; CACHED_MODE -->
    <AppendMode>EQUIOX_MODE</AppendMode>
    <alpha>2</alpha>
    <!-- LRC: UniLRC; AzureLRC; OptimalLRC; UniformLRC -->
    <CodeType>RS</CodeType>
    <k>10</k>
    <r>4</r>
    <z>0</z>
